{
  "info": {
    "name": "VetClinic API",
    "description": "Multi-tenant veterinary clinic management system.\n\n**Setup:**\n1. Run \"Login\" first to get a token\n2. Token is auto-saved to {{accessToken}} variable\n3. All other requests use it automatically\n\n**Variables:**\n- baseUrl: http://localhost:8080\n- clinicId: your clinic UUID\n- accessToken: auto-set after login",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "clinicId", "value": "b5434818-265f-4386-8ed5-e568a238a451" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "ownerId", "value": "" },
    { "key": "petId", "value": "" },
    { "key": "speciesId", "value": "" },
    { "key": "breedId", "value": "" },
    { "key": "appointmentId", "value": "" },
    { "key": "medicalRecordId", "value": "" },
    { "key": "treatmentId", "value": "" },
    { "key": "vaccinationId", "value": "" },
    { "key": "prescriptionId", "value": "" },
    { "key": "serviceId", "value": "" },
    { "key": "invoiceId", "value": "" },
    { "key": "invoiceItemId", "value": "" },
    { "key": "paymentId", "value": "" },
    { "key": "locationId", "value": "" },
    { "key": "roleId", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "userLocationId", "value": "" },
    { "key": "inventoryItemId", "value": "" },
    { "key": "inventoryTransactionId", "value": "" },
    { "key": "documentId", "value": "" },
    { "key": "notificationId", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set('accessToken', json.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', json.refreshToken);",
                  "    pm.collectionVariables.set('userId', json.user.id);",
                  "    pm.collectionVariables.set('roleId', json.user.roleId);",
                  "    pm.test('Login successful', function() {",
                  "        pm.expect(json.accessToken).to.be.a('string');",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"clinicId\": \"{{clinicId}}\",\n    \"email\": \"admin@test.com\",\n    \"password\": \"admin123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set('accessToken', json.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', json.refreshToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/refresh", "host": ["{{baseUrl}}"], "path": ["api", "auth", "refresh"] }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/auth/logout", "host": ["{{baseUrl}}"], "path": ["api", "auth", "logout"] }
          }
        }
      ]
    },
